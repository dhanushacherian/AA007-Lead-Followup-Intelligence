  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  background: #f4f7fb;
}

button {
  font: inherit;
}

button:focus-visible {
  outline: 3px solid #8bb4e5;
  outline-offset: 3px;
}

#root {
  min-height: 100vh;
}
