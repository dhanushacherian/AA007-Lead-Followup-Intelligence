        ("AA007-HOT-001", "FOLLOW_UP_NOW", "route_follow_up_now"),
        ("AA007-WARM-001", "FOLLOW_UP_SOON", "route_follow_up_soon"),
        ("AA007-STALE-001", "NURTURE", "route_nurture"),
