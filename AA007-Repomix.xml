        assert audit_response.status_code == 200

        trace = audit_response.json()["graph_execution_trace"]

        completed_routes = [
            event["node"]
            for event in trace
            if event["status"] == "completed"
            and event["node"].startswith("route_")
        ]

        assert completed_routes == [expected_route], lead_id
        assert {
            "node": expected_route,
            "status": "started",
        } in trace
        assert {
            "node": expected_route,
            "status": "completed",
        } in trace
