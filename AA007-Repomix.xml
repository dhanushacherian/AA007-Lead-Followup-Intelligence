.agent-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.agent-card { border: 1px solid #e5eaf0; border-radius: 9px; padding: 13px; min-width: 0; }
.agent-card-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 9px; }
.step-number { color: #7894b0; font-size: 9px; font-weight: 800; }
.agent-status { color: #26805d; background: #eff8f3; border-radius: 20px; padding: 4px 7px; font-size: 8px; font-weight: 700; }
.agent-card h4 { margin: 0 0 6px; color: #314c68; font-size: 12px; }
.agent-card p, .agent-card li { color: #758397; font-size: 10px; line-height: 1.55; }
.agent-card ul { padding-left: 15px; margin: 5px 0; }
.detail-label { display: block; color: #8491a1; font-size: 9px; margin: 10px 0 4px; }
.agent-score { color: #315e8d !important; font-weight: 700; }
.raw-details { margin-top: 9px; }
.raw-details summary { cursor: pointer; color: #315e8d; font-size: 10px; font-weight: 700; }
pre { max-width: 100%; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; border-radius: 7px; background: #f5f7fa; color: #536477; padding: 11px; font-size: 9px; line-height: 1.5; }
.audit-section { border-top: 1px solid #edf0f4; padding-top: 17px; }
.audit-section .panel-heading { align-items: center; }
.audit-section .panel-heading h3 { margin-bottom: 4px; }
.audit-section .panel-heading p { margin: 0; }
.success-note { color: #237653; font-size: 10px; font-weight: 700; }
.audit-result { margin-top: 12px; }
.audit-result .advanced-meta { margin-bottom: 12px; }
.muted { color: #8793a2; font-size: 11px; line-height: 1.6; }
.error-banner { margin: 12px 0; padding: 11px 13px; border: 1px solid #f0d5d8; border-radius: 8px; background: #fff6f6; color: #9d4a53; font-size: 11px; overflow-wrap: anywhere; }
.footer { display: flex; justify-content: space-between; gap: 18px; border-top: 1px solid #e3e9f0; margin-top: 34px; padding-top: 17px; color: #929dab; font-size: 9px; line-height: 1.5; }
@media (max-width: 900px) {
  .app-shell { padding: 0 22px 28px; }
  .welcome-section { align-items: flex-start; flex-direction: column; }
  .welcome-action { justify-content: flex-start; }
  .how-panel { grid-template-columns: 1fr; }
  .workspace-grid { grid-template-columns: 1fr; }
  .lead-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 620px) {
  .app-shell { padding: 0 15px 24px; }
  .topbar { min-height: 68px; }
  .brand strong { font-size: 12px; }
  .brand small { font-size: 10px; }
  .connection-pill { padding: 7px 9px; font-size: 9px; }
  .main-nav { gap: 19px; }
  .welcome-section { padding: 30px 0 22px; }
  .welcome-section h1 { font-size: 29px; }
  .welcome-action { align-items: flex-start; flex-direction: column; }
  .metrics-grid { grid-template-columns: 1fr; gap: 9px; margin-bottom: 25px; }
  .metric-card { min-height: 82px; padding: 13px 15px; }
  .metric-card strong { font-size: 22px; }
  .section-heading { align-items: flex-start; flex-direction: column; }
  .lead-grid, .result-grid, .agent-grid { grid-template-columns: 1fr; }
  .process-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .panel { padding: 15px; }
  .detail-grid { gap: 11px; }
  .recommendation-card { align-items: flex-start; flex-direction: column; padding: 17px; }
  .score-box { display: flex; align-items: center; gap: 8px; }
  .advanced-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .advanced-content { padding: 14px; }
  .audit-section .panel-heading { align-items: flex-start; flex-direction: column; }
  .footer { flex-direction: column; gap: 5px; }
}
